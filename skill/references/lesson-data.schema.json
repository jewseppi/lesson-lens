{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lesson-data.v2",
  "title": "Language Lesson Study Package (language-agnostic)",
  "description": "Generalized from lesson-data.v1. Field names are language roles (target / reading / translation) rather than a specific language, so the same schema works for Mandarin, Japanese, Korean, Spanish, or any other target language, with or without a romanization/reading system.",
  "type": "object",
  "required": [
    "schema_version",
    "lesson_id",
    "lesson_date",
    "title",
    "source_session_ids",
    "language_profile",
    "summary",
    "key_sentences",
    "vocabulary",
    "corrections",
    "review"
  ],
  "properties": {
    "schema_version": { "const": "lesson-data.v2" },
    "lesson_id": { "type": "string" },
    "lesson_date": { "type": "string" },
    "title": { "type": "string" },
    "source_session_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "language_profile": {
      "type": "object",
      "description": "Echoes the profile this pack was generated under, so the output is self-describing.",
      "required": ["target_language", "reading_system", "reading_policy", "native_language"],
      "properties": {
        "target_language": {
          "type": "string",
          "description": "The language being learned, e.g. 'Mandarin Chinese', 'Japanese', 'Spanish'."
        },
        "script": {
          "type": ["string", "null"],
          "description": "Script/orthography constraint if the language has one, e.g. 'traditional', 'simplified', 'kanji+kana', or null when not applicable (e.g. Spanish)."
        },
        "reading_system": {
          "type": "string",
          "description": "Pronunciation aid to attach to target-language text, e.g. 'pinyin-numeric', 'pinyin-diacritic', 'romaji', 'furigana', 'revised-romanization', or 'none'."
        },
        "reading_policy": {
          "type": "string",
          "enum": ["every_line", "new_words_only", "none"],
          "description": "When reading_system is 'none', this is 'none'."
        },
        "native_language": {
          "type": "string",
          "description": "The learner's language, used for translations and explanations, e.g. 'English'."
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["overview", "short_recap"],
      "properties": {
        "overview": { "type": "string" },
        "usage_notes": { "type": "string" },
        "short_recap": { "type": "string" },
        "teacher_focus": { "type": "string" },
        "student_focus": { "type": "string" }
      }
    },
    "key_sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target", "translation", "source_refs"],
        "properties": {
          "id": { "type": "string" },
          "target": {
            "type": "string",
            "description": "The sentence in the target language, in the required script."
          },
          "reading": {
            "type": "string",
            "description": "Romanization / pronunciation aid. Required by the validator when reading_policy is 'every_line'; may be empty or omitted when reading_system is 'none'."
          },
          "translation": {
            "type": "string",
            "description": "Translation into the native language."
          },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "context_note": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "translation", "pos_or_type", "example_target", "example_translation"],
        "properties": {
          "term": { "type": "string" },
          "reading": { "type": "string" },
          "translation": { "type": "string" },
          "pos_or_type": { "type": "string" },
          "example_target": { "type": "string" },
          "example_reading": { "type": "string" },
          "example_translation": { "type": "string" },
          "example_is_composed": {
            "type": "boolean",
            "description": "true when the example was composed rather than taken verbatim from the transcript. Composed examples must use only vocabulary from the lesson. Lets a reviewer trace composed material without parsing free-text flags."
          },
          "frequency_tag": { "type": "string" },
          "difficulty": { "type": "string" },
          "related_terms": { "type": "array", "items": { "type": "string" } },
          "source_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "corrections": {
      "type": "array",
      "description": "Teacher corrections, captured verbatim. Already language-agnostic in v1 — unchanged.",
      "items": {
        "type": "object",
        "required": ["id", "learner_original", "teacher_correction", "reason", "source_refs"],
        "properties": {
          "id": { "type": "string" },
          "learner_original": { "type": "string" },
          "teacher_correction": { "type": "string" },
          "reason": { "type": "string" },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "pattern_tag": { "type": "string" },
          "practice_prompt": { "type": "string" }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["flashcards", "fill_blank", "translation_drills", "quiz"],
      "properties": {
        "flashcards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "front", "back"],
            "properties": {
              "id": { "type": "string" },
              "front": { "type": "string" },
              "back": { "type": "string" },
              "hint": { "type": "string" },
              "tags": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "fill_blank": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "sentence", "blank_word", "answer"],
            "properties": {
              "id": { "type": "string" },
              "sentence": { "type": "string" },
              "blank_word": { "type": "string" },
              "answer": { "type": "string" },
              "hint": { "type": "string" }
            }
          }
        },
        "translation_drills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source_lang", "source_text", "target_text"],
            "properties": {
              "id": { "type": "string" },
              "source_lang": {
                "type": "string",
                "enum": ["native", "target"],
                "description": "Which language the prompt is in. 'native' → learner produces the target language (harder); 'target' → learner produces their native language (easier)."
              },
              "source_text": { "type": "string" },
              "target_text": { "type": "string" },
              "hint": { "type": "string" }
            }
          }
        },
        "quiz": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "question", "options", "correct_index"],
            "properties": {
              "id": { "type": "string" },
              "question": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
              "correct_index": { "type": "integer", "minimum": 0 },
              "explanation": { "type": "string" }
            }
          }
        }
      }
    },
    "grammar_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string" },
          "explanation": { "type": "string" },
          "examples": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "confidence_flags": {
      "type": "array",
      "description": "Where the model was unsure. Fidelity depends on surfacing uncertainty rather than guessing silently.",
      "items": {
        "type": "object",
        "required": ["area", "level", "detail"],
        "properties": {
          "area": { "type": "string" },
          "level": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "The model's confidence in the flagged item: 'low' = least confident and most in need of human review (same direction as key_sentences.confidence)."
          },
          "detail": { "type": "string" },
          "source_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Optional. Paths to rendered files if the host app writes them; not produced by the skill itself.",
      "properties": {
        "markdown_path": { "type": "string" },
        "html_path": { "type": "string" },
        "flashcards_csv_path": { "type": "string" },
        "anki_csv_path": { "type": "string" },
        "image_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "generation_meta": {
      "type": "object",
      "description": "Optional provenance. Loose on purpose: a skill run inside an agent has no provider/token bill to report.",
      "properties": {
        "produced_by": { "type": "string" },
        "homepage": { "type": "string", "description": "Optional link to the skill's project/source, e.g. for attribution in exported packs." },
        "prompt_version": { "type": "string" },
        "generated_at": { "type": "string" },
        "run_id": { "type": "string" },
        "post_edit_notes": { "type": "string" }
      }
    },
    "appendix": { "type": "object" }
  }
}
