# Copy this file to .env and fill in one provider key.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Local provider settings (no API keys required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LOCAL_OAI_BASE_URL=http://localhost:1234/v1
LOCAL_OAI_MODEL=local-model

# GitHub Actions runner generation (optional)
GITHUB_TOKEN=ghp_your-fine-grained-token
GITHUB_REPO=owner/repo
GENERATION_WEBHOOK_TOKEN=replace-with-a-random-secret

# Recommended to override for local use.
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-long-random-string

# One-touch macOS updater (scripts/line_mac_sync.py / `make update`) and the
# hosted MCP server (api/mcp_server_hosted.py). Point these at your hosted
# LessonLens so both can log in, sync, and read/write sessions.
LESSONLENS_API_URL=https://your-lessonlens-host.example.com
LESSONLENS_EMAIL=you@example.com
LESSONLENS_PASSWORD=your-password

# Retention window for automatic pre-sync restore points, in days (default 7),
# and the per-user cap on how many are kept (default 20). The cap matters
# because snapshots include images.
# LESSONLENS_RESTORE_RETENTION_DAYS=7
# LESSONLENS_RESTORE_MAX_POINTS=20

# Only needed for `make push` (local -> hosted) when the hosted instance has
# DIFFERENT credentials than the local one. Otherwise the local values are used.
# LESSONLENS_REMOTE_URL=https://your-lessonlens-host.example.com
# LESSONLENS_REMOTE_EMAIL=you@example.com
# LESSONLENS_REMOTE_PASSWORD=your-hosted-password

# Which instance to talk to: "hosted" (default) or "local".
# "local" means a LessonLens server running on this machine; it still speaks
# HTTP, defaulting to http://127.0.0.1:5000 (override with LESSONLENS_LOCAL_URL).
LESSONLENS_TARGET=hosted
# LESSONLENS_LOCAL_URL=http://127.0.0.1:5000

# Subscription-agent generation. When set, `make update` runs this command once
# per session that still needs a summary, so generation uses your flat-rate agent
# subscription instead of a metered provider API key. {session_id} is substituted.
#
# Unset means "prepare only": the updater reports what needs doing and runs
# nothing. Verify your choice with `make doctor` (checks the binary resolves) and
# `make doctor-agent` (actually runs it once against a real session).
#
# Pick one. The prompt is the same in each; only the CLI's non-interactive flag
# differs. -p / --print / exec are each that CLI's "run once and exit" mode.
#
# The agent must also be allowed to CALL the MCP tools without prompting — in
# print mode there is no one to answer a permission prompt, so without this the
# run exits non-zero having done nothing.
#
# Claude Code — verified working: this exact form connected to the hosted MCP
# server and read live sessions with no provider API key. Do NOT add
# --permission-mode bypassPermissions; it maps to --dangerously-skip-permissions,
# which is refused outright when running as root.
# LESSONLENS_AGENT_CMD=claude -p "Summarize LessonLens session {session_id} using the lessonlens-hosted MCP server. Read it with get_session, check get_retrieval_context for prior vocabulary, then write the lesson-data.v1 package with store_summary (lesson_date must equal {session_id})." --allowedTools "mcp__lessonlens-hosted__*"
#
# GitHub Copilot CLI (untested here — check its own allow-tools flag):
# LESSONLENS_AGENT_CMD=copilot -p "Summarize LessonLens session {session_id} using the lessonlens-hosted MCP server. Read it with get_session, check get_retrieval_context for prior vocabulary, then write the lesson-data.v1 package with store_summary (lesson_date must equal {session_id})."
#
# Codex CLI (untested here — check its own allow-tools flag):
# LESSONLENS_AGENT_CMD=codex exec "Summarize LessonLens session {session_id} using the lessonlens-hosted MCP server. Read it with get_session, check get_retrieval_context for prior vocabulary, then write the lesson-data.v1 package with store_summary (lesson_date must equal {session_id})."